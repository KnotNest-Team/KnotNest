# KnotNest server configuration.
# `npm install` / `npm run dev` copy this file to server/.env automatically (and generate a random JWT_SECRET).
# Never commit server/.env and never use these development values in production.

NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# --- Database -------------------------------------------------------------
# Local MongoDB, or an Atlas string: mongodb+srv://<user>:<password>@<cluster>/knotnest
MONGO_URI=mongodb://127.0.0.1:27017/knotnest
# auto  = use MONGO_URI; if unreachable (development only) start an embedded MongoDB automatically
# true  = always use the embedded development database
# false = never fall back (fail if MONGO_URI is unreachable)
USE_MEMORY_DB=auto
# Load demo data when the database is empty (development only). Use `npm run seed` to reset it manually.
AUTO_SEED=true

# --- Auth -----------------------------------------------------------------
# Generated automatically by the setup script. In production set a long random value.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Limits ---------------------------------------------------------------
# Requests per IP per 15 minutes on /api (defaults: 100000 in development, 3000 in production)
# RATE_LIMIT_MAX=3000

# --- Uploads --------------------------------------------------------------
# local (default) or cloudinary (then: npm i cloudinary --prefix server)
STORAGE_PROVIDER=local
MAX_FILE_SIZE_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Public links ---------------------------------------------------------
# The website address used in invitation emails (RSVP links). Defaults to the first CLIENT_URL.
# In production set it to your live site, e.g. https://knotnest.vercel.app
PUBLIC_APP_URL=

# --- Email (wedding invitations) ------------------------------------------
# Leave SMTP_HOST empty in development: emails go to an Ethereal test inbox, or (offline) are saved
# as HTML files you can open from the Guests page. Fill these in to deliver real emails.
#   Brevo (free 300/day):  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASS=<SMTP key>
#   Gmail (App Password):  SMTP_HOST=smtp.gmail.com        SMTP_PORT=465  SMTP_USER=<you@gmail.com>  SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465, false for 587 (auto-detected from the port when empty)
SMTP_SECURE=
# Sender shown to guests. With Brevo/Gmail this must be an address you verified with that provider.
MAIL_FROM="KnotNest Invitations <invites@example.com>"
# auto (default) | smtp | ethereal | outbox
MAIL_MODE=auto

# --- Payments (booking advance, Razorpay test mode) ------------------------
# Get test keys at https://dashboard.razorpay.com (Settings > API Keys, Test Mode).
# Empty in development = clearly labelled simulated payments. Required in production for payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Advance the couple pays to lock a date, and KnotNest's commission, as % of the booking value
ADVANCE_PERCENT=10
COMMISSION_PERCENT=8
